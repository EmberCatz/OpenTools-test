{
  "name": "opentools-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local backend for OpenTools - ingests OpenWF Sync.pluto's inventory pushes into SQLite, serves /api/* for the app frontend. See ../DEVLOG.md.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "snapshot:scratch": "node scripts/snapshot-scratch-db.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
